# Anthropic key lives only in the agent service (spec §13.2). Never commit
# a real value; in GCP this is injected from Secret Manager, not this file.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model the ADK agent runs on. Default is fast/cheap for
# tool-routing; upgrade to sonnet for an exec demo (spec §9, §13.4).
MODEL_ID=anthropic/claude-haiku-4-5-20251001

# Locks the agent service's CORS to the UI's origin (spec §13.2).
UI_ORIGIN=http://localhost:5173

# Read at agent-container start (spec §16.1). Cloud Run sets this
# automatically in production; only needed for local parity.
PORT=8080

# Demo default is stdio (co-located, no network hop). Set to
# streamable-http only when running mcp_server/ as its own service
# (production topology, spec §16.2).
MCP_TRANSPORT=stdio

# UI build-time only (ui/.env, not this file) — the agent's HTTP endpoint
# the thin client calls. Never a secret; the UI holds no key.
VITE_AGENT_URL=http://localhost:8080
